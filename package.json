{
  "name": "talk-show-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "worker": "ts-node --project tsconfig.worker.json src/workers/index.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "setup": "docker-compose up -d && timeout 10 && npm run dev",
    "check:ai": "curl -s http://localhost:11434/api/tags",
    "check:voice": "curl -s http://localhost:4123/health"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.28",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@supabase/supabase-js": "^2.88.0",
    "assemblyai": "^4.22.1",
    "bullmq": "^5.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "openai": "^4.76.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "youtube-dl-exec": "^3.0.27",
    "youtube-transcript": "^1.2.1",
    "youtubei.js": "^16.0.1",
    "zod": "^3.24.1"
  },
