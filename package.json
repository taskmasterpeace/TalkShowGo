{
  "name": "talk-show-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "show:build": "node lab/engine/make_episode_build.mjs",
    "show:bootstrap": "node lab/engine/bootstrap_topic.mjs",
    "show:voice": "node lab/engine/render_breeze.mjs segment",
    "show:takes": "node lab/engine/take_link.mjs",
    "show:activity": "node lab/engine/activity.mjs",
    "show:dossier": "node lab/engine/dossier_report.mjs --latest",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "setup": "docker-compose up -d && timeout 10 && npm run dev",
    "go": "docker-compose up -d && timeout /t 5 /nobreak && npm run dev",
    "stop": "docker-compose down",
    "check:ai": "curl -s http://localhost:11434/api/tags",
    "check:voice": "curl -s http://localhost:8765/health",
    "check:db": "docker exec tsg-postgres pg_isready -U postgres",
    "scheduler:start": "start-scheduler.bat"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.28",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@supabase/supabase-js": "^2.88.0",
    "assemblyai": "^4.22.1",
    "bullmq": "^5.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "node-cron": "^3.0.3",
    "openai": "^4.76.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "youtube-caption-extractor": "^1.9.0",
    "youtube-dl-exec": "^3.0.27",
    "youtubei.js": "^16.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
