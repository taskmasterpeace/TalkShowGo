# ============================================
# Talk Show Go - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real API keys!

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talkshowgo
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret (min 32 characters) - for PostgREST
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# ============================================
# REDIS (for job queue)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# API KEYS - External Services
# ============================================

# Twitter/X API (TwitterAPI.io - pay-as-you-go)
# Sign up at https://twitterapi.io/dashboard
# Pricing: $0.15/1K tweets, $0.18/1K users
TWITTER_API_KEY=

# YouTube API (optional - youtubei.js is free alternative)
# Get key at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Perplexity Sonar API (AI-powered web search)
# Get key at https://www.perplexity.ai/settings/api
# 5 free credits/month, ~$0.006 per query
PERPLEXITY_API_KEY=

# OpenAI (for content generation)
# Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (alternative LLM)
# Get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ElevenLabs (text-to-speech)
# Get key at https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ============================================
# LOCAL AI SERVICES (optional)
# ============================================

# Ollama/Presidium (local LLM)
PRESIDIUM_URL=http://localhost:11434
LOCAL_LLM_URL=http://localhost:1234/v1

# SearXNG (self-hosted search)
SEARXNG_URL=http://localhost:8888

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
