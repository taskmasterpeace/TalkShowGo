{
  "schema_version": 1,
  "youtube": {
    "trusted_channels_max": 5,
    "results_per_trusted_channel": 2,
    "global_results": 6,
    "transcript_limit": 6,
    "transcript_words_per_video": 12000,
    "transcript_words_total": 60000,
    "cache_ttl_hours": 168
  },
  "web": {
    "default_provider": "openrouter",
    "max_results": 6,
    "openrouter_model": "google/gemini-2.5-flash-lite",
    "perplexity_model": "perplexity/sonar"
  },
  "parser": {
    "provider": "openrouter",
    "model": "google/gemini-2.5-flash-lite",
    "temperature": 0.1,
    "max_output_tokens": 5000
  },
  "impartiality": {
    "min_distinct_publishers": 2,
    "require_evidence_on_factual_moves": true,
    "reject_invented_urls": true
  }
}
