{
  "_readme": "PROVEN LTX-2.5 audio-driven lip-sync ComfyUI API graph (cupcake box, 2026-08-14). Stage artist.png + vocal.wav into /srv/ai/projects/comfy/ComfyUI/input first. Replace <TRANSCRIPT> with the whisper transcript of the vocal, and the LoadImage/LoadAudio filenames. POST as {\"prompt\": <this minus _readme keys>} to :8188/prompt. Node 'ato' = AudioTimestepOverride (must be installed) — THIS is what makes the mouth move. ~96s/5s @480p, distilled int8.",
  "1":  {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "2":  {"class_type": "LTXAVTextEncoderLoader", "inputs": {"text_encoder": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "ckpt_name": "ltx-2.3-22b-dev-fp8.safetensors", "device": "default"}},
  "3v": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "3a": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},
  "5":  {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "A young Black woman rapping to camera, neon Miami night, medium close-up, singing the words. The person is talking, and she says: \"<TRANSCRIPT>\""}},
  "6":  {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "worst quality, blurry, distorted, still, frozen face"}},
  "7":  {"class_type": "LTXVConditioning", "inputs": {"positive": ["5", 0], "negative": ["6", 0], "frame_rate": 24.0}},
  "8":  {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": 832, "height": 480, "length": 121, "batch_size": 1}},
  "8i": {"class_type": "LoadImage", "inputs": {"image": "artist.png"}},
  "8p": {"class_type": "LTXVPreprocess", "inputs": {"image": ["8i", 0], "img_compression": 18}},
  "8c": {"class_type": "LTXVImgToVideoInplace", "inputs": {"vae": ["3v", 0], "image": ["8p", 0], "latent": ["8", 0], "strength": 1.0, "bypass": false}},
  "9a": {"class_type": "LoadAudio", "inputs": {"audio": "vocal.wav"}},
  "9enc": {"class_type": "LTXVAudioVAEEncode", "inputs": {"audio": ["9a", 0], "audio_vae": ["3a", 0]}},
  "9m": {"class_type": "SolidMask", "inputs": {"value": 0.0, "width": 512, "height": 512}},
  "9x": {"class_type": "SetLatentNoiseMask", "inputs": {"samples": ["9enc", 0], "mask": ["9m", 0]}},
  "10": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["8c", 0], "audio_latent": ["9x", 0]}},
  "1s": {"class_type": "ModelSamplingLTXV", "inputs": {"model": ["1", 0], "max_shift": 2.05, "base_shift": 0.95, "latent": ["10", 0]}},
  "ato": {"class_type": "AudioTimestepOverride", "inputs": {"model": ["1s", 0], "audio_timestep_scale": 0.93}},
  "11": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral_cfg_pp"}},
  "12": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "13": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "14": {"class_type": "CFGGuider", "inputs": {"model": ["ato", 0], "positive": ["7", 0], "negative": ["7", 1], "cfg": 1.0}},
  "15": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["14", 0], "sampler": ["11", 0], "sigmas": ["12", 0], "latent_image": ["10", 0]}},
  "16": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["15", 0]}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["3v", 0]}},
  "18": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["16", 1], "audio_vae": ["3a", 0]}},
  "19": {"class_type": "CreateVideo", "inputs": {"images": ["17", 0], "audio": ["18", 0], "fps": 24.0}},
  "20": {"class_type": "SaveVideo", "inputs": {"video": ["19", 0], "filename_prefix": "video/ltx25_lipsync", "format": "auto", "codec": "auto"}}
}
